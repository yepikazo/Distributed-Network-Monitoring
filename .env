# Ubah angka di sini lalu `docker compose up`
WORKERS=4
# workers = target dari IP worker yang terhubung (default)
# file    = baca targets.txt
# both    = gabungan keduanya
TARGET_SOURCE=workers
# 0 = pakai IP worker; isi >0 untuk target sintetis (mis. 200)
SYNTH=0
REPEAT=3
COUNT=1
TIMEOUT=0.3
# 0 = otomatis (1 untuk IP worker, 50 untuk file/sintetis)
CHUNK=0
# count = task dibagi merata; idle = work-conserving; off = bebas
FAIRNESS=count
MODE=dynamic
WORKER_CORES=1
DISCOVERY_TIMEOUT=30
MAX_RUNTIME=300
TAG=docker
